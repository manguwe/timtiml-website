# ── Copy to .env.local for local development; add the same names in Vercel → Settings → Environment Variables ──

# Password for the /admin page where you upload pictures and documents (use 8+ characters).
ADMIN_SECRET=choose-a-strong-password

# File storage. In Vercel: your project → Storage → Create → Blob → Connect to project.
# Vercel then adds BLOB_READ_WRITE_TOKEN for you automatically. (For local dev: `vercel env pull .env.local`.)
BLOB_READ_WRITE_TOKEN=

# Optional: your public address (used for SEO / sitemap).
NEXT_PUBLIC_SITE_URL=https://timtiml-website.vercel.app
